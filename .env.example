# Supabase — required for database features
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI Assistant — required for the AI city assistant feature
# Supports any OpenAI-compatible API (Groq, OpenRouter, etc.)
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_MODEL_NAME=llama-3.1-8b-instant

# Optional: canonical production URL used by metadata and shared links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
